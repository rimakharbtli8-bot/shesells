# CLOSER — Environment Variables
# Copy this file to .env.local and fill in real values when ready.
# The app runs entirely on realistic mock data as long as these are unset.

# LLM used to play the customer role and generate coaching feedback.
# This is an Anthropic API key (get one at console.anthropic.com) — the app
# calls the Claude API directly via @anthropic-ai/sdk (see lib/ai/claudeClient.ts).
LLM_API_KEY=

# Speech-to-Text provider used to transcribe the user's voice answers.
SPEECH_TO_TEXT_API_KEY=

# Text-to-Speech provider used to give the simulated customer a voice.
TEXT_TO_SPEECH_API_KEY=

# WhatsApp community invite link, shown on the Community page.
# Exposed to the client on purpose (it's a public invite link), but kept
# in one place so it can be swapped without touching any code.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=HIER_SPAETER_LINK_EINFUEGEN
